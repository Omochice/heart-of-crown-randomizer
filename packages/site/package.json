{
	"name": "@heart-of-crown-randomizer/site",
	"private": true,
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"build": "vite build",
		"build-storybook": "storybook build",
		"check": "npm-run-all2 check:*",
		"check:svelte": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"dev": "vite dev",
		"fmt": "npm-run-all2 fmt:*",
		"fmt:package": "sort-package-json",
		"fmt:prettier": "prettier --write \"**/*.svelte\"",
		"prepare": "svelte-kit sync || echo ''",
		"preview": "vite preview",
		"storybook": "storybook dev -p 6006",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"watch:check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"dependencies": {
		"@heart-of-crown-randomizer/card": "workspace:*",
		"@heart-of-crown-randomizer/constraint": "workspace:*",
		"@heart-of-crown-randomizer/id-codec": "workspace:*",
		"@heart-of-crown-randomizer/randomizer": "workspace:*"
	},
	"devDependencies": {
		"@playwright/test": "1.64.1",
		"@storybook/addon-docs": "10.6.5",
		"@storybook/addon-svelte-csf": "5.1.6",
		"@storybook/svelte": "10.6.5",
		"@storybook/sveltekit": "10.6.5",
		"@sveltejs/adapter-cloudflare": "8.0.1",
		"@sveltejs/kit": "3.1.0",
		"@sveltejs/mcp": "0.1.28",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.3",
		"@testing-library/svelte": "5.4.2",
		"@types/node": "26.6.6",
		"@vitest/browser-playwright": "5.0.5",
		"jsdom": "30.1.3",
		"lucide-svelte": "1.0.1",
		"npm-run-all2": "catalog:",
		"playwright": "1.64.1",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"sort-package-json": "catalog:",
		"storybook": "10.6.5",
		"svelte": "5.57.3",
		"svelte-check": "4.7.7",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"vite": "8.3.5",
		"vitest": "catalog:"
	}
}
